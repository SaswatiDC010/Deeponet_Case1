"""
train_deeponet.py
DeepONet for Case 1 of the 1-D steady diffusion equation.

PDE:
    d/dx ( k dP/dx ) = f,     0 <= x <= 1
    P(0) = 0,  P(1) = 0

Case 1:
    k = constant for each realization
    f = constant for each realization

Exact solution:
    P(x) = f/(2k) * (x^2 - x)

The program:
1. Loads the data generated by data_generation.py
2. Builds a DeepONet
3. Trains it using pressure data
4. Tests it on unseen k and f values
5. Plots actual vs predicted pressure
6. Prints test error metrics
7. Saves the trained model
"""

import random
from pathlib import Path

import numpy as np
import matplotlib.pyplot as plt

import torch
import torch.nn as nn
from torch.utils.data import TensorDataset, DataLoader


# ----------------------------- USER SETTINGS ----------------------------- #
DATA_FILE = "case1_deeponet_data.npz"
MODEL_FILE = "deeponet_case1.pt"

SEED = 42
EPOCHS = 1000
BATCH_SIZE = 64
LEARNING_RATE = 1e-3

BRANCH_WIDTH = 128
TRUNK_WIDTH = 128
LATENT_DIM = 64

NUM_PLOTS = 5
# ------------------------------------------------------------------------- #


def set_seed(seed):
    """Make training as reproducible as reasonably possible."""
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)

    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


class BranchNet(nn.Module):
    """
    Branch network.

    Input:
        sampled k(x) and f(x) values

    Output:
        latent representation of the input functions
    """

    def __init__(self, input_dim, width, latent_dim):
        super().__init__()

        self.net = nn.Sequential(
            nn.Linear(input_dim, width),
            nn.Tanh(),

            nn.Linear(width, width),
            nn.Tanh(),

            nn.Linear(width, width),
            nn.Tanh(),

            nn.Linear(width, latent_dim)
        )

    def forward(self, branch_input):
        return self.net(branch_input)


class TrunkNet(nn.Module):
    """
    Trunk network.

    Input:
        spatial coordinate x

    Output:
        latent representation of the coordinate
    """

    def __init__(self, width, latent_dim):
        super().__init__()

        self.net = nn.Sequential(
            nn.Linear(1, width),
            nn.Tanh(),

            nn.Linear(width, width),
            nn.Tanh(),

            nn.Linear(width, width),
            nn.Tanh(),

            nn.Linear(width, latent_dim)
        )

    def forward(self, x):
        return self.net(x)


class DeepONet(nn.Module):
    """
    Standard DeepONet:

        G(k,f)(x) = sum_i branch_i(k,f) * trunk_i(x) + bias

    The branch network represents the input functions k and f.
    The trunk network represents the location x.
    """

    def __init__(self, branch_input_dim, branch_width,
                 trunk_width, latent_dim):
        super().__init__()

        self.branch_net = BranchNet(
            branch_input_dim, branch_width, latent_dim
        )

        self.trunk_net = TrunkNet(
            trunk_width, latent_dim
        )

        self.bias = nn.Parameter(torch.zeros(1))

    def forward(self, branch_input, x):
        """
        Parameters
        ----------
        branch_input : [batch, branch_input_dim]
        x            : [number_of_query_points, 1]

        Returns
        -------
        pressure : [batch, number_of_query_points]
        """
        branch_output = self.branch_net(branch_input)
        trunk_output = self.trunk_net(x)

        # Inner product in the latent dimension.
        pressure = torch.matmul(
            branch_output, trunk_output.T
        ) + self.bias

        return pressure


def relative_l2_error(predicted, actual):
    """Relative L2 error for the whole test set."""
    numerator = torch.linalg.norm(predicted - actual)
    denominator = torch.linalg.norm(actual)

    return (numerator / denominator).item()


def main():
    set_seed(SEED)

    device = torch.device(
        "cuda" if torch.cuda.is_available() else "cpu"
    )

    print("=" * 65)
    print("DeepONet - Case 1")
    print("=" * 65)
    print("Device:", device)

    base_dir = Path(__file__).resolve().parent
    data_path = base_dir / DATA_FILE
    model_path = base_dir / MODEL_FILE

    if not data_path.exists():
        raise FileNotFoundError(
            f"\nData file not found:\n{data_path}\n\n"
            "Run data_generation.py first."
        )

    # ------------------------------------------------------------------ #
    # 1. LOAD DATA
    # ------------------------------------------------------------------ #

    data = np.load(data_path)

    x_sensors = data["x_sensors"]
    x_query = data["x_query"]

    train_branch = data["train_branch"]
    train_pressure = data["train_pressure"]

    test_branch = data["test_branch"]
    test_pressure = data["test_pressure"]

    test_k = data["test_k"]
    test_f = data["test_f"]

    print("\nData loaded successfully.")
    print("Training branch input :", train_branch.shape)
    print("Training pressure     :", train_pressure.shape)
    print("Testing branch input  :", test_branch.shape)
    print("Testing pressure      :", test_pressure.shape)

    # ------------------------------------------------------------------ #
    # 2. CONVERT DATA TO PYTORCH TENSORS
    # ------------------------------------------------------------------ #

    train_branch_tensor = torch.tensor(
        train_branch, dtype=torch.float32
    )

    train_pressure_tensor = torch.tensor(
        train_pressure, dtype=torch.float32
    )

    test_branch_tensor = torch.tensor(
        test_branch, dtype=torch.float32
    )

    test_pressure_tensor = torch.tensor(
        test_pressure, dtype=torch.float32
    )

    x_tensor = torch.tensor(
        x_query[:, None], dtype=torch.float32
    )

    # DataLoader randomly creates mini-batches of input functions.
    train_dataset = TensorDataset(
        train_branch_tensor,
        train_pressure_tensor
    )

    train_loader = DataLoader(
        train_dataset,
        batch_size=BATCH_SIZE,
        shuffle=True
    )

    # ------------------------------------------------------------------ #
    # 3. CREATE DEEPONET
    # ------------------------------------------------------------------ #

    branch_input_dim = train_branch.shape[1]

    model = DeepONet(
        branch_input_dim=branch_input_dim,
        branch_width=BRANCH_WIDTH,
        trunk_width=TRUNK_WIDTH,
        latent_dim=LATENT_DIM
    ).to(device)

    optimizer = torch.optim.Adam(
        model.parameters(),
        lr=LEARNING_RATE
    )

    loss_function = nn.MSELoss()

    print("\nDeepONet created.")
    print("Branch input dimension:", branch_input_dim)
    print("Latent dimension       :", LATENT_DIM)

    # ------------------------------------------------------------------ #
    # 4. TRAIN
    # ------------------------------------------------------------------ #

    loss_history = []

    print("\nTraining started...")

    for epoch in range(1, EPOCHS + 1):

        model.train()
        epoch_loss = 0.0

        for branch_batch, pressure_batch in train_loader:

            branch_batch = branch_batch.to(device)
            pressure_batch = pressure_batch.to(device)

            optimizer.zero_grad()

            predicted_pressure = model(
                branch_batch,
                x_tensor.to(device)
            )

            loss = loss_function(
                predicted_pressure,
                pressure_batch
            )

            loss.backward()
            optimizer.step()

            epoch_loss += loss.item() * branch_batch.size(0)

        epoch_loss /= len(train_loader.dataset)
        loss_history.append(epoch_loss)

        if epoch == 1 or epoch % 100 == 0:
            print(
                f"Epoch {epoch:4d}/{EPOCHS} | "
                f"Training Loss = {epoch_loss:.8e}"
            )

    print("Training completed.")

    # ------------------------------------------------------------------ #
    # 5. TEST ON UNSEEN k AND f
    # ------------------------------------------------------------------ #

    model.eval()

    with torch.no_grad():

        predicted_test = model(
            test_branch_tensor.to(device),
            x_tensor.to(device)
        ).cpu()

    actual_test = test_pressure_tensor

    test_mse = torch.mean(
        (predicted_test - actual_test) ** 2
    ).item()

    test_rmse = np.sqrt(test_mse)

    test_relative_l2 = relative_l2_error(
        predicted_test,
        actual_test
    )

    print("\n" + "=" * 65)
    print("TEST RESULTS")
    print("=" * 65)
    print(f"MSE          : {test_mse:.8e}")
    print(f"RMSE         : {test_rmse:.8e}")
    print(f"Relative L2  : {test_relative_l2:.6e}")
    print("=" * 65)

    # ------------------------------------------------------------------ #
    # 6. SAVE TRAINED MODEL
    # ------------------------------------------------------------------ #

    torch.save(
        {
            "model_state_dict": model.state_dict(),
            "branch_input_dim": branch_input_dim,
            "branch_width": BRANCH_WIDTH,
            "trunk_width": TRUNK_WIDTH,
            "latent_dim": LATENT_DIM,
            "x_sensors": x_sensors,
            "x_query": x_query,
        },
        model_path
    )

    print(f"\nModel saved to:\n{model_path}")

    # ------------------------------------------------------------------ #
    # 7. PLOT TRAINING LOSS
    # ------------------------------------------------------------------ #

    plt.figure(figsize=(7, 5))
    plt.semilogy(loss_history)
    plt.xlabel("Epoch")
    plt.ylabel("Mean squared error")
    plt.title("DeepONet training loss - Case 1")
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.savefig(
        base_dir / "training_loss_case1.png",
        dpi=300
    )
    plt.show()

    # ------------------------------------------------------------------ #
    # 8. ACTUAL VS PREDICTED PRESSURE
    # ------------------------------------------------------------------ #

    num_plots = min(NUM_PLOTS, len(test_branch))

    fig, axes = plt.subplots(
        num_plots, 1,
        figsize=(8, 3.2 * num_plots),
        squeeze=False
    )

    axes = axes.ravel()

    for i in range(num_plots):

        ax = axes[i]

        ax.plot(
            x_query,
            actual_test[i].numpy(),
            linewidth=2,
            label="Actual"
        )

        ax.plot(
            x_query,
            predicted_test[i].numpy(),
            "--",
            linewidth=2,
            label="DeepONet prediction"
        )

        ax.set_xlabel("x")
        ax.set_ylabel("Pressure P(x)")
        ax.set_title(
            f"Test sample {i + 1}: "
            f"k = {test_k[i]:.3f}, f = {test_f[i]:.3f}"
        )

        ax.grid(True, alpha=0.3)
        ax.legend()

    plt.tight_layout()

    plot_path = base_dir / "actual_vs_predicted_case1.png"

    plt.savefig(
        plot_path,
        dpi=300
    )

    plt.show()

    print(f"\nActual vs predicted plot saved to:\n{plot_path}")

    # ------------------------------------------------------------------ #
    # 9. PARITY PLOT
    # ------------------------------------------------------------------ #

    plt.figure(figsize=(6, 6))

    actual_flat = actual_test.numpy().ravel()
    predicted_flat = predicted_test.numpy().ravel()

    plt.scatter(
        actual_flat,
        predicted_flat,
        s=8,
        alpha=0.35
    )

    minimum = min(
        actual_flat.min(),
        predicted_flat.min()
    )

    maximum = max(
        actual_flat.max(),
        predicted_flat.max()
    )

    plt.plot(
        [minimum, maximum],
        [minimum, maximum],
        "--",
        linewidth=2,
        label="Ideal: predicted = actual"
    )

    plt.xlabel("Actual pressure")
    plt.ylabel("Predicted pressure")
    plt.title("DeepONet parity plot - Case 1")
    plt.grid(True, alpha=0.3)
    plt.legend()
    plt.tight_layout()

    parity_path = base_dir / "parity_plot_case1.png"

    plt.savefig(
        parity_path,
        dpi=300
    )

    plt.show()

    print(f"Parity plot saved to:\n{parity_path}")


if __name__ == "__main__":
    main()
